{
  "name": "n8n-sports-predictor-web",
  "version": "1.0.0",
  "description": "Web dashboard for n8n sports predictions",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed:nba": "node scripts/seedNbaMetadata.js",
    "distances:nba": "node scripts/buildArenaDistances.js",
    "ingest:nba": "node scripts/ingestNbaGames.js",
    "boxscores:nba": "node scripts/ingestNbaBoxscores.js",
    "features:nba": "node scripts/buildNbaFeatures.js",
    "export:nba-training": "node scripts/exportNbaTrainingData.js",
    "train:nba-model": "python3 model/train_nba_model.py",
    "refresh:nba-model": "node scripts/refreshNbaModel.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2"
  }
}
